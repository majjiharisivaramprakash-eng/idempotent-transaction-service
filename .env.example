# Copy to .env and adjust as needed. All values below are the defaults.

# Path to the SQLite database file (relative paths resolve from the repo root)
TXN_DB_PATH=txn.db

# Worker mode: embedded (started with the API), external (standalone process), off (API only)
TXN_WORKER_MODE=embedded

# Worker poll interval in seconds
TXN_POLL_INTERVAL_SECONDS=1.0

# Maximum processing attempts before a job is marked FAILED
TXN_MAX_ATTEMPTS=3

# Base backoff in seconds between retries (doubles per attempt)
TXN_BACKOFF_BASE_SECONDS=1.0

# Fault-injection sentinels for demonstrating resilience (minor units).
# A transaction with this exact amount fails once, then succeeds on retry.
TXN_FAULT_TRANSIENT_AMOUNT=1111
# A transaction with this exact amount fails on every attempt (retry exhaustion).
TXN_FAULT_PERMANENT_AMOUNT=2222
